//--------    FILE: alpha.bhv   -------------

initialize   DEPLOY = false
initialize   RETURN = false

//----------------------------------------------
Behavior=BHV_Loiter
{
  name      = loiter_behavior
  pwt       = 100
  condition = DEPLOY = true
  condition = RETURN = false
  updates   = LOITER_UPDATES
  endflag   = RETURN=true

  polygon   = format=radial, pts=8, label=loiter_poly, snap=1, radius=30, x=100,y=-75
  clockwise = false
  duration  = 150
  speed     = 2.5
}

//----------------------------------------------
Behavior=BHV_Waypoint
{
  name      = waypt_return
  pwt       = 100
  condition = RETURN = true
  condition = DEPLOY = true
  perpetual = true
  updates   = RETURN_UPDATE
  endflag   = RETURN = false
  endflag   = DEPLOY = false
  endflag   = MISSION = complete
	
           speed = 2.0
  capture_radius = 2.0
     slip_radius = 8.0
          points = 0,0
 }