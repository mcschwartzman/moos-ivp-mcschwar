//-----------------------------------------------
// Helm Behavior file 

initialize   DEPLOY  = true
initialize   RETURN  = false
initialize   STATION_KEEP = false
initialize   VISIT  = true
initialize    REFUEL_NEEDED = false

set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

set MODE = STATION-KEEPING {
  MODE = ACTIVE
  STATION_KEEP = true
  RETURN       = false
}

set MODE = REFUELING {
  MODE = ACTIVE:STATION-KEEPING
  REFUEL_NEEDED = true
} NOT_REFUELING

set MODE = RETURNING {
  MODE          = ACTIVE
  RETURN        = true
}

set MODE = RETURNING_TO_REFUEL {
  MODE            = ACTIVE:RETURNING
  REFUEL_NEEDED   = true
} REFUEL_NOT_NEEDED

set MODE = VISITING {
  MODE = ACTIVE
  VISIT = true
}

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = waypt_visit
  pwt       = 100
  condition = (MODE==VISITING)
  endflag   = STATION_KEEP = true
  endflag   = RETURN = false
  updates   = UPDATES_WAYPOINT
  perpetual = true
  post_suffix = _VISIT

      speed = 1.3
     radius = 3.0
  nm_radius = 15.0
     points = 10,10:12,12
       lead = 8
}


Behavior = BHV_Waypoint
{
  name        = waypt_return
  pwt         = 100
  updates     = UPDATES_RETURN
  condition   = MODE==RETURNING
  endflag     = RETURN = false
  spawnx_flag = RETURN_UPDATES=point=$[OSX],$[OSY]

      speed = 1.3
     radius = 3.0
  nm_radius = 15.0
     points = 0,0
     repeat = 0
       lead = 8
}

//----------------------------------------------
Behavior = BHV_StationKeep
{
  name      = station-keep
  pwt       = 100
  condition = MODE==STATION-KEEPING

   center_activate = true
      inner_radius = 5
      outer_radius = 10 
       outer_speed = 1.0
     transit_speed = 1.3
        swing_time = 7
      visual_hints = vertex_size=0, edge_color=gray50
}

//----------------------------------------------
Behavior = BHV_Timer
{
  name        = refuel_timer
  condition   = (MODE==REFUELING)
  duration    = 60
  duration_idle_decay = false
  perpetual   = true

  endflag     = VISIT=true
  endflag     = REFUEL_NEEDED=false
  endflag     = RETURN=false
  endflag     = STATION_KEEP=false


}

//----------------------------------------------
Behavior = BHV_Timer
{
  name = no-refuel-needed
  condition   = (MODE==VISITING)
  duration    = 300
  duration_idle_decay = false
  perpetual   = true
  duration_reset = REFUEL_NEEDED=false

  endflag     = REFUEL_NEEDED=true
  endflag     = RETURN=true
}